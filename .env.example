# Server-side Gemini API Key (injected automatically by AI Studio)
GEMINI_API_KEY=

# Server-side TMDB API Key
TMDB_API_KEY=

# Master secret (32+ random characters) for AES-256-GCM server vault encryption
VAULT_SECRET=

# Optional verified Firebase Owner UID and Email for Admin endpoints
ADMIN_OWNER_UID=
ADMIN_OWNER_EMAIL=

# Optional explicit production domain for CORS allow-list
ALLOWED_ORIGIN=

